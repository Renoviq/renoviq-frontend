# Copy to .env (git-ignored). These are the public web-app settings from the Firebase console
# (Project settings > General > Your apps). They are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only for `npm run dev`: where the backend runs (default http://localhost:3000)
# VITE_DEV_API=http://localhost:3000
